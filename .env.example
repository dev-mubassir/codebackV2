# ============================================
# Codeback — Environment Variables
# Copy this to backend/.env and fill in your values
# ============================================

# ---- Meta / Instagram App ----
# Get these from https://developers.facebook.com → Your App → App Settings → Basic
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Random string used to verify webhook requests from Meta
# Set this same value in your Meta App's webhook configuration
WEBHOOK_VERIFY_TOKEN=codeback_webhook_verify_123

# ---- Backend ----
# SQLite database file (stored locally). Swap to a Postgres URL in production.
DATABASE_URL=file:./codeback.db

# Secret for session cookies. REQUIRED in production — the server refuses to
# start if this is unset or left at a default value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-secret-string

# Optional: 64-char hex string for AES-256 token encryption
# If not set, SESSION_SECRET is used to derive the key
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Server port
PORT=5000

# URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Must match the redirect URI configured in your Meta App
REDIRECT_URI=http://localhost:5000/auth/instagram/callback

# ---- Development Helpers ----
# Set to 'true' to skip webhook signature verification (for testing with ngrok)
SKIP_SIGNATURE_VERIFICATION=false

# ---- Codeback AI Assistant ----
# Provider used for conversation classification, priority scoring, brand-deal
# extraction, conversation summaries, and on-demand reply drafting.
# Leave GEMINI_API_KEY blank to run with AI gracefully degraded to "other"
# (messages still arrive/persist/display normally).
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---- Background Jobs ----
# Enables the production Redis/BullMQ queue for async AI processing.
# Leave blank to use the built-in in-process queue (fine for local dev /
# single-instance deployments) — same retry/backoff/concurrency behavior.
REDIS_URL=

# ---- Admin Panel ----
# REQUIRED to enable admin login — there is NO default. Prefer a bcrypt hash
# (ADMIN_PASSWORD_HASH) over plaintext. Generate a hash with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'your-strong-password'
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_EMAILS=

# ---- CORS / Cookies ----
# Extra allowed browser origins (comma-separated), in addition to FRONTEND_URL.
ALLOWED_ORIGINS=
# Session cookie SameSite policy. Default 'lax' (recommended). Use 'none' only
# for cross-domain frontends AND add CSRF tokens; 'none' also requires HTTPS.
COOKIE_SAMESITE=lax

# ---- Public support address (frontend) ----
# Printed on /privacy, /terms, and /data-deletion, which Meta App Review
# opens directly. Must be a mailbox a real person reads: deletion requests
# arrive here and those pages promise a reply within 30 days.
# The production build FAILS if this is unset (see frontend/src/content/contact.js).
NEXT_PUBLIC_SUPPORT_EMAIL=support@siffty.com
