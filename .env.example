# ============================================
# Codeback — Environment Variables
# Copy this to backend/.env and fill in your values
# ============================================

# ---- Meta / Instagram App ----
# Get these from https://developers.facebook.com → Your App → App Settings → Basic
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Random string used to verify webhook requests from Meta
# Set this same value in your Meta App's webhook configuration
WEBHOOK_VERIFY_TOKEN=codeback_webhook_verify_123

# ---- Backend ----
# Postgres. Local dev: the codeback-pg Docker container (see LOCAL_DEV.md).
# In production the pool is capped in code (lib/prisma.js): connection_limit=5
# and pool_timeout=20 are added unless the URL sets them; DB_POOL_SIZE
# overrides the Prisma share.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/codeback
DB_POOL_SIZE=

# Secret for session cookies. REQUIRED in production — the server refuses to
# start if this is unset or left at a default value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-secret-string

# Optional during a rotation: the previous SESSION_SECRET, so existing cookies
# stay valid until they expire.
SESSION_SECRET_PREVIOUS=

# REQUIRED: 64-char hex string for AES-256-GCM token encryption. Must never
# change for an existing database (stored Instagram tokens become unreadable).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# REQUIRED: HMAC key for OAuth state, and the pepper for Instagram identity
# hashes. Generate each like SESSION_SECRET. The pepper must never change.
OAUTH_STATE_SECRET=
IG_IDENTITY_PEPPER=

# ---- Google sign-in ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server port
PORT=5000

# URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Must match the redirect URI configured in your Meta App
REDIRECT_URI=http://localhost:5000/auth/instagram/callback

# ---- Development Helpers ----
# Set to 'true' to skip webhook signature verification (for testing with ngrok)
SKIP_SIGNATURE_VERIFICATION=false

# ---- Siffty AI ----
# Which provider/model is used is chosen in the admin panel (Admin -> AI), from
# a fixed allowlist in backend/src/lib/ai/models.js. With nothing chosen, it is
# Gemini Flash-Lite. Keys live ONLY here: the panel shows "key configured:
# yes/no" and no endpoint ever accepts or returns a key. Each is optional —
# a provider without a key simply cannot be selected.
# Leave every key blank to run with AI gracefully degraded to "other"
# (messages still arrive/persist/display normally).
# (AI_PROVIDER, GROK_API_KEY and XAI_API_KEY are no longer read.)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Redis (optional; required to run more than one API instance) ----
# When set: BullMQ job queue, the Socket.io Redis adapter (events reach sockets
# on every instance), and shared rate limits / email quota. Sessions stay in
# Postgres either way. Leave blank for local dev and single-instance runs —
# everything falls back to in-process memory (this is also the rollback path).
# Production: linked from the Northflank Redis addon, never typed in.
REDIS_URL=
# Skip TLS certificate verification for a rediss:// URL whose certificate the
# Node trust store does not know (a provider's internal endpoint). Default off.
REDIS_TLS_INSECURE=

# ---- Scheduled jobs ----
# In-process timers, safe with any number of instances (each job runs once per
# interval: due-check + Postgres advisory lock, see backend/src/jobs/scheduler.js).
# 'false' turns every timer off (staging default; the kill switch). Default on.
RUN_IN_PROCESS_SCHEDULER=true

# ---- Reverse proxy ----
# Proxy hops in front of the API: decides the client IP (rate limits) and
# HTTPS detection (Secure cookie). Default 1. A hop count, true/false, or
# Express's subnet syntax.
TRUST_PROXY=

# ---- Email (Resend) ----
# Without a key, local dev logs emails (with links) to the console. In
# production the server REFUSES TO START without a key unless EMAIL_DRY_RUN=true,
# because that console output would contain live reset/verification tokens.
RESEND_API_KEY=
FROM_EMAIL=noreply@mail.siffty.com
REPLY_TO_EMAIL=
SUPPORT_EMAIL=
EMAIL_DAILY_CAP=
EMAIL_CRITICAL_RESERVE=
# 'true' sends NOTHING and logs only the email type and a hashed recipient.
# Staging on a copy of real data must set this: every address in it is real.
EMAIL_DRY_RUN=false

# ---- Billing (Cashfree) ----
# Master switch. Off: billing routes, the Cashfree webhook and billing jobs 404/skip.
BILLING_ENABLED=false
# 'sandbox' or 'production'. Unset falls back to NODE_ENV (production -> LIVE).
# Set it explicitly everywhere, and keep NEXT_PUBLIC_CASHFREE_MODE identical.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
# Also the webhook signing key (Cashfree has no separate webhook secret).
CASHFREE_SECRET_KEY=
# 'true' REJECTS Cashfree webhooks whose timestamp is outside ±5 min. Default
# off (log-only) until sandbox confirms what timestamp a retry carries.
WEBHOOK_TIMESTAMP_ENFORCE=false
META_APPROVED=false
USD_PRICING_ENABLED=false

# ---- Admin Panel ----
# No environment variables. Admins are rows in admin_users, created with
# `node backend/scripts/create-admin.js` — see ADMIN.md. The old
# ADMIN_USERNAME / ADMIN_PASSWORD / ADMIN_PASSWORD_HASH / ADMIN_EMAILS are
# no longer read (the server warns at boot if they are still set).

# ---- CORS / Cookies ----
# Extra allowed browser origins (comma-separated), in addition to FRONTEND_URL.
ALLOWED_ORIGINS=
# Session cookie SameSite policy. Default 'lax' (recommended). Use 'none' only
# for cross-domain frontends AND add CSRF tokens; 'none' also requires HTTPS.
COOKIE_SAMESITE=lax

# ---- Public support address (frontend) ----
# Printed on /privacy, /terms, and /data-deletion, which Meta App Review
# opens directly. Must be a mailbox a real person reads: deletion requests
# arrive here and those pages promise a reply within 30 days.
# The production build FAILS if this is unset (see frontend/src/content/contact.js).
NEXT_PUBLIC_SUPPORT_EMAIL=support@siffty.com

# ---- Frontend build arguments (inlined at build time: one image per environment) ----
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
# Must equal the backend's CASHFREE_ENV.
NEXT_PUBLIC_CASHFREE_MODE=sandbox
NEXT_PUBLIC_BUSINESS_CITY=
# Canonical site URL for Open Graph / metadataBase. Default https://app.siffty.com.
NEXT_PUBLIC_SITE_URL=
