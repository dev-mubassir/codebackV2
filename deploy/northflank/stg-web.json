{
  "name": "stg-web",
  "description": "TEMPORARY staging web for scale-prod (delete in Gate 4)",
  "tags": [
    "stg"
  ],
  "billing": {
    "deploymentPlan": "nf-compute-20",
    "buildPlan": "nf-compute-400-16"
  },
  "deployment": {
    "type": "deployment",
    "instances": 1,
    "storage": {
      "ephemeralStorage": {
        "storageSize": 1024
      }
    }
  },
  "ports": [
    {
      "name": "site",
      "internalPort": 3000,
      "public": true,
      "protocol": "HTTP"
    }
  ],
  "vcsData": {
    "projectUrl": "https://github.com/dev-mubassir/codebackV2",
    "projectType": "github",
    "projectBranch": "scale-prod",
    "accountLogin": "dev-mubassir"
  },
  "buildSettings": {
    "dockerfile": {
      "buildEngine": "buildkit",
      "dockerFilePath": "/frontend/Dockerfile",
      "dockerWorkDir": "/frontend",
      "useCache": true
    }
  },
  "runtimeEnvironment": {
    "PORT": "3000"
  },
  "healthChecks": [
    {
      "protocol": "HTTP",
      "type": "readinessProbe",
      "path": "/",
      "port": 3000,
      "initialDelaySeconds": 5,
      "periodSeconds": 10,
      "timeoutSeconds": 3,
      "failureThreshold": 3,
      "successThreshold": 1
    }
  ],
  "disabledCI": true,
  "disabledCD": true
}