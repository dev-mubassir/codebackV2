{
  "name": "stg-api",
  "description": "TEMPORARY staging API for scale-prod (delete in Gate 4)",
  "billing": {
    "deploymentPlan": "nf-compute-50",
    "buildPlan": "nf-compute-400-16"
  },
  "deployment": {
    "type": "deployment",
    "instances": 1,
    "storage": {
      "ephemeralStorage": {
        "storageSize": 1024
      }
    }
  },
  "ports": [
    {
      "name": "site",
      "internalPort": 5000,
      "public": true,
      "protocol": "HTTP"
    }
  ],
  "vcsData": {
    "projectUrl": "https://github.com/dev-mubassir/codebackV2",
    "projectType": "github",
    "projectBranch": "scale-prod",
    "accountLogin": "dev-mubassir"
  },
  "buildSettings": {
    "dockerfile": {
      "buildEngine": "buildkit",
      "dockerFilePath": "/backend/Dockerfile",
      "dockerWorkDir": "/backend",
      "useCache": true
    }
  },
  "healthChecks": [
    {
      "protocol": "HTTP",
      "type": "readinessProbe",
      "path": "/health",
      "port": 5000,
      "initialDelaySeconds": 10,
      "periodSeconds": 10,
      "timeoutSeconds": 3,
      "failureThreshold": 3,
      "successThreshold": 1
    },
    {
      "protocol": "HTTP",
      "type": "livenessProbe",
      "path": "/livez",
      "port": 5000,
      "initialDelaySeconds": 20,
      "periodSeconds": 15,
      "timeoutSeconds": 3,
      "failureThreshold": 4
    }
  ],
  "disabledCI": true,
  "disabledCD": true,
  "tags": [
    "stg"
  ],
  "runtimeEnvironment": {
    "PORT": "5000"
  }
}