{
  "_note": "Project 'siffty', region asia-south-delhi. Records of what was created (northflank create ... -f <file>); names and non-secret defaults only - the owner enters every secret value in the UI.",
  "name": "prod-secrets",
  "description": "Production runtime env for api and migrate. Owner enters every empty value.",
  "type": "secret",
  "secretType": "environment-arguments",
  "priority": 10,
  "restrictions": {
    "restricted": true,
    "nfObjects": [
      {
        "id": "api",
        "type": "service"
      },
      {
        "id": "migrate",
        "type": "job"
      }
    ]
  },
  "addonDependencies": [
    {
      "addonId": "postgres",
      "keys": [
        {
          "keyName": "POSTGRES_URI",
          "aliases": [
            "DATABASE_URL"
          ]
        },
        {
          "keyName": "HOST",
          "aliases": [
            "DB_HOST"
          ]
        },
        {
          "keyName": "PORT",
          "aliases": [
            "DB_PORT"
          ]
        },
        {
          "keyName": "USERNAME",
          "aliases": [
            "DB_USER"
          ]
        },
        {
          "keyName": "PASSWORD",
          "aliases": [
            "DB_PASSWORD"
          ]
        },
        {
          "keyName": "DATABASE",
          "aliases": [
            "DB_NAME"
          ]
        }
      ]
    },
    {
      "addonId": "redis",
      "keys": [
        {
          "keyName": "REDIS_MASTER_URL",
          "aliases": [
            "REDIS_URL"
          ]
        }
      ]
    }
  ],
  "secrets": {
    "variables": {
      "NODE_ENV": "production",
