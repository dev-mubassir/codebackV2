// This is the Prisma schema for Codeback — AI Instagram DM Assistant SaaS
//
// Core tables: users, instagram_accounts, contacts, conversations, messages
// AI/product tables: ai_analyses, conversation_summaries, brand_deals,
//                     reply_generations, creator_preferences, notifications
// Auth/identity: auth_tokens, auth_identities, oauth_nonces
// Anti-abuse:   instagram_identities (pseudonymised trial ledger; survives
//                     account deletion by design)
// Entitlement:  subscriptions (TRIAL ONLY — no billing until after Meta
//                     approval; status defaults to NONE so nothing can grant
//                     a trial by accident)
// Compliance:   deletion_requests
// Platform ops: admin_logs, webhook_logs
//
// NOTE: usage_events no longer exists — it was dropped alongside the reverted
// Cashfree billing work in 20260903120000_remove_subscription_and_usage.
//
// NOTE: status/category/priority fields are plain Strings validated at the
// application layer (see backend/src/lib/constants.js for the canonical
// allowed values). They stayed Strings through the SQLite -> PostgreSQL move
// so the migration carried no data rewrite; promoting them to real Postgres
// enums is a separate, optional change.
//
// Datasource is PostgreSQL. Migrations live in prisma/migrations and are the
// schema's source of truth — apply them with `prisma migrate deploy`, never
// `prisma db push`, which would drift production silently.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Codeback user — a person using the SaaS.
// A User is the tenant/account boundary: every owned row is scoped by a
// userId (directly or transitively through instagramAccountId/conversationId)
// and every server-side query MUST filter by the authenticated user's id.
// ============================================
model User {
  id                  String    @id @default(uuid())
  email               String?   @unique
  // Nullable because Google-only users have no password, and because
  // IG-created users historically had neither email nor password.
  passwordHash        String?   @map("password_hash")
  name                String?
  role                String    @default("USER") // "USER" or "ADMIN"
  isSuspended         Boolean   @default(false) @map("is_suspended")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  // Null until the address is proven. Gates Google account linking (an
  // unverified local email must never be auto-linked to a Google identity)
  // and gates the trial grant.
  emailVerifiedAt     DateTime? @map("email_verified_at")
  // Bumped on password reset. requireAuth compares the session's copy against
  // this value, so a reset invalidates every existing session without
  // scanning the session store.
  sessionVersion      Int       @default(0) @map("session_version")
  lastSeenAt          DateTime? @map("last_seen_at") // last time the user opened the app
  // The two OPTIONAL renewal nudges (day 27, day 29). The expiry-day and
  // grace-final notices are service notices and ignore this. See
  // jobs/renewalReminderJob.js and migration 20260915170000_renewal_nudge_emails.
  renewalNudgeEmails  Boolean   @default(true) @map("renewal_nudge_emails")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  businessProfile   BusinessProfile?
  instagramAccounts InstagramAccount[]
  adminLogs         AdminLog[]
  preferences       CreatorPreference?
  brandDeals        BrandDeal[]
  replyGenerations  ReplyGeneration[]
  notifications     Notification[]
  authTokens        AuthToken[]
  authIdentities    AuthIdentity[]
  entitlement       Entitlement?

  @@map("users")
}

// ============================================
// Business Profile — persistent context for AI DM understanding & auto-reply.
// Allows Codeback to serve Creators, Video Editors, Product Sellers, Freelancers,
// E-commerce, Agencies, Local Businesses, and Coaches.
// ============================================
model BusinessProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  businessName       String? @map("business_name")
  businessTypes      String? @map("business_types") // JSON array of types e.g. ["video_editor", "freelancer"]
  primaryCategory    String? @map("primary_category") // e.g. "video_editor", "product_seller", "creator"
  description        String? // Core description of what the user does
  productsServices   String? @map("products_services") // Details of products/services offered
  pricingInfo        String? @map("pricing_info") // Starting price, price range, packages
  targetAudience     String? @map("target_audience") // Target customers
  locationDelivery   String? @map("location_delivery") // Service area, shipping availability
  paymentMethods     String? @map("payment_methods") // Accepted payment modes
  faqData            String? @map("faq_data") // FAQs and answers
  policies           String? // Turnaround times, warranty, refund/revision terms
  contactPreferences String? @map("contact_preferences") // Preferred contact methods
  aiInstructions     String? @map("ai_instructions") // Custom rules for AI
  prohibitedTopics   String? @map("prohibited_topics") // Things AI must never promise or answer
  tone               String  @default("friendly") // friendly, professional, casual, concise, warm, custom
  // Defaults to "human_only": automatic sending is opt-in, never opt-out. A new
  // account still gets the full analysis pipeline — classification, priority
  // scoring, brand-deal extraction, summaries, notifications, live inbox
  // updates — it just never sends a DM on the user's behalf until they
  // explicitly choose "smart" in Settings. Reply drafts remain available
  // on demand via POST /api/conversations/:id/generate-reply.
  // Keep this in sync with services/businessProfileService.js DEFAULT_PROFILE
  // and the profile created in routes/auth.js at registration.
  autoReplyMode      String  @default("human_only") @map("auto_reply_mode") // "smart", "suggest_only", "human_only"
  minConfidenceScore Int     @default(75) @map("min_confidence_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

// ============================================
// Connected Instagram Professional account
// ============================================
model InstagramAccount {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  igUserId         String    @map("ig_user_id") // Instagram User ID (numeric string)
  igUsername       String?   @map("ig_username")
  igName           String?   @map("ig_name")
  igProfilePic     String?   @map("ig_profile_pic")
  // LEGACY token column, retained deliberately during the transition to the
  // split columns below. See FINDINGS.md D3: this column and the
  // "legacy plain-text" passthrough in lib/crypto.js are the only things
  // keeping any pre-encryption row working, so neither may be removed until
  // the backfill is verified complete in EVERY environment, production
  // included. Dropped in a later, separate migration.
  accessToken      String    @map("access_token") // Long-lived token ("iv:ciphertext:tag")
  // Split token storage. Nullable for now: the SQL backfill below populates
  // rows already in iv:ct:tag form, but plaintext rows can only be encrypted
  // by the Node backfill script (AES is not available in SQL). Promoted to
  // NOT NULL in the same later migration that drops accessToken.
  tokenCiphertext  String?   @map("token_ciphertext")
  tokenIv          String?   @map("token_iv")
  tokenAuthTag     String?   @map("token_auth_tag")
  // Lets a future key rotation identify which key encrypted a given row,
  // instead of silently failing to decrypt everything at once.
  tokenKeyVersion  Int       @default(1) @map("token_key_version")
  tokenExpiresAt   DateTime? @map("token_expires_at")
  tokenStatus      String    @default("VALID") @map("token_status") // "VALID", "EXPIRED", "NEEDS_RECONNECT"
  // Connection lifecycle is intentionally separate from historical data.
  // Disconnecting NEVER deletes contacts/conversations/messages — it only
  // flips this flag.
  //
  // igUserId is NO LONGER globally unique. A global unique made a legitimate
  // workspace-to-workspace move impossible: the old row could never be kept
  // as history while a new one was created. Uniqueness is now:
  //   - @@unique([userId, igUserId])  — one row per (user, IG account) link
  //   - ig_one_active_link            — a raw partial unique index allowing
  //                                     only ONE CONNECTED row per IG account
  // Disconnected rows therefore persist as history and may duplicate, which
  // is exactly what lets InstagramIdentity distinguish a legitimate transfer
  // from trial abuse.
  connectionStatus String    @default("CONNECTED") @map("connection_status") // "CONNECTED", "DISCONNECTED"
  disconnectedAt   DateTime? @map("disconnected_at")
  lastWebhookAt    DateTime? @map("last_webhook_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  conversations Conversation[]
  webhookLogs   WebhookLog[]
  brandDeals    BrandDeal[]

  @@unique([userId, igUserId])
  @@index([userId])
  @@index([igUserId])
  @@map("instagram_accounts")
}

// ============================================
// A person who has messaged an Instagram account
// ============================================
model Contact {
  id                 String    @id @default(uuid())
  instagramAccountId String    @map("instagram_account_id")
  igsid              String    @map("igsid") // Instagram Scoped ID of the contact
  username           String?
  name               String?
  profilePicUrl      String?   @map("profile_pic_url")
  lastFetchedAt      DateTime? @map("last_fetched_at") // When we last fetched their profile
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  conversations    Conversation[]

  // Each contact is unique per Instagram account
  @@unique([instagramAccountId, igsid])
  @@index([instagramAccountId])
  @@map("contacts")
}

// ============================================
// A conversation thread between an IG account and a contact.
//
// `category`/`priority`/`priorityScore`/`needsAttention`/`unread` are fast,
// denormalized read fields kept in sync by the AI analysis worker so the
// inbox can filter/sort without joining ai_analyses on every request.
// ============================================
model Conversation {
  id                 String @id @default(uuid())
  instagramAccountId String @map("instagram_account_id")
  contactId          String @map("contact_id")

  category          String?
  intent            String? // e.g. "pricing_inquiry", "product_details", "service_inquiry", "support", "collab", "spam", "scam"
  customerType      String? @map("customer_type") // "potential_buyer", "existing_customer", "lead", "hot_lead", "casual_fan", "partner", "spammer", "unknown"
  leadQuality       Int?    @map("lead_quality") // 0-100 score
  purchaseIntent    Int?    @map("purchase_intent") // 0-100 score
  riskLevel         String  @default("low") @map("risk_level") // "low", "medium", "high", "critical"
  scamProbability   Int     @default(0) @map("scam_probability") // 0-100
  aiExplanation     String? @map("ai_explanation") // Explainable reasoning for human
  recommendedAction String? @map("recommended_action") // e.g. "ANSWER_PRICE", "SEND_PORTFOLIO", "ESCALATE_HUMAN", "BLOCK_SPAM"
  needsHuman        Boolean @default(false) @map("needs_human") // Explicit human escalation flag

  priority           String    @default("normal") // "critical", "high", "normal", "low"
  priorityScore      Int       @default(0) @map("priority_score") // 0-100, deterministic + AI blended score
  needsAttention     Boolean   @default(false) @map("needs_attention")
  unread             Boolean   @default(true)
  // Per-conversation auto-reply override. Deliberately THREE-state:
  //   null  -> inherit BusinessProfile.autoReplyMode (the default for new rows)
  //   true  -> opt this conversation in
  //   false -> opt this conversation OUT, even when the tenant is on "smart"
  // A plain Boolean @default(false) could not distinguish "never touched" from
  // "explicitly turned off", which is why toggling a chat off did nothing while
  // the account was in smart mode.
  autoReplyEnabled   Boolean?  @map("auto_reply_enabled")
  autoReplyPrompt    String?   @map("auto_reply_prompt") // custom prompt/rules for this specific chat
  // Mutex for the auto-reply send path. The gate counts prior auto-replies,
  // then awaits an AI call, then sends — so without a claim two concurrent
  // analysis jobs both read the pre-send counts and both send, and the real
  // customer receives two DMs. A worker takes the claim with a conditional
  // updateMany (atomic) and releases it in a finally. A stale claim left by a
  // crashed process expires, so auto-reply cannot wedge permanently.
  autoReplyClaimedAt DateTime? @map("auto_reply_claimed_at")

  lastMessage   String?   @map("last_message")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  instagramAccount InstagramAccount     @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  contact          Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages         Message[]
  analyses         AIAnalysis[]
  summaryRecord    ConversationSummary?
  brandDeals       BrandDeal[]
  replyGenerations ReplyGeneration[]

  // One conversation per contact per IG account
  @@unique([instagramAccountId, contactId])
  @@index([instagramAccountId, lastMessageAt])
  @@index([contactId])
  @@index([priority])
  @@index([category])
  @@index([customerType])
  @@index([intent])
  @@index([riskLevel])
  @@index([unread])
  @@index([needsAttention])
  @@index([needsHuman])
  @@index([autoReplyEnabled])
  @@map("conversations")
}

// ============================================
// A single message in a conversation.
// ============================================
model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  igMessageId    String?   @unique @map("ig_message_id") // Instagram's message ID (for deduplication)
  direction      String // "inbound" or "outbound"
  content        String?
  category       String? // legacy convenience copy of the conversation's category at the time of this message
  suggestedReply String?   @map("suggested_reply")
  messageType    String    @default("text") @map("message_type") // text, image, video, story_mention, etc.
  attachmentUrl  String?   @map("attachment_url")
  igTimestamp    DateTime? @map("ig_timestamp") // Timestamp from Instagram

  aiStatus   String    @default("pending") @map("ai_status") // "pending", "processing", "completed", "failed", "skipped"
  // The classification gate's reason when aiStatus is "skipped": "not_entitled",
  // "cycle_cap" or "hourly_throttle". NULL otherwise, and for skips recorded
  // before the column existed.
  aiSkipReason  String?   @map("ai_skip_reason")
  // Set when a skipped message is re-queued after an entitlement grant
  // (services/skippedMessageRecovery.js). A recovered message may auto-reply
  // only if it arrived within the last hour; older ones are classified only.
  aiRecoveredAt DateTime? @map("ai_recovered_at")
  attempts   Int       @default(0)
  analyzedAt DateTime? @map("analyzed_at")

  createdAt DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([aiStatus])
  @@map("messages")
}

// ============================================
// AI Analysis — append-only, versioned record of AI's understanding of a
// conversation.
// ============================================
model AIAnalysis {
  id               String  @id @default(uuid())
  conversationId   String  @map("conversation_id")
  triggerMessageId String? @map("trigger_message_id")

  category          String
  intent            String?
  customerType      String? @map("customer_type")
  leadQuality       Int?    @map("lead_quality")
  purchaseIntent    Int?    @map("purchase_intent")
  riskLevel         String? @map("risk_level")
  scamProbability   Int?    @map("scam_probability")
  shouldAutoReply   Boolean @default(false) @map("should_auto_reply")
  recommendedAction String? @map("recommended_action")

  priority       String // "critical", "high", "normal", "low"
  priorityScore  Int     @default(0) @map("priority_score")
  confidence     Float   @default(0)
  needsAttention Boolean @default(false) @map("needs_attention")
  summary        String?
  reason         String?

  model        String?
  rawResponse  String? @map("raw_response")
  status       String  @default("completed")
  errorMessage String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_analyses")
}

// ============================================
// Conversation Summary — one evolving, periodically-updated summary per
// conversation (not regenerated on every single message).
// ============================================
model ConversationSummary {
  id                      String   @id @default(uuid())
  conversationId          String   @unique @map("conversation_id")
  summary                 String
  stage                   String? // e.g. "Waiting for campaign details"
  lastSummarizedMessageId String?  @map("last_summarized_message_id")
  messageCountAtSummary   Int      @default(0) @map("message_count_at_summary")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_summaries")
}

// ============================================
// Brand Deal — structured extraction of a commercial collaboration.
// Missing information is left null/unknown; nothing is invented.
// ============================================
model BrandDeal {
  id                 String @id @default(uuid())
  // One evolving deal per conversation. Without the unique constraint,
  // concurrent analyses both miss the findFirst and both create a row, so the
  // creator gets two "new brand deal" notifications and double usage billing
  // for one deal. services/brandDealService.js upserts against this.
  conversationId     String @unique @map("conversation_id")
  instagramAccountId String @map("instagram_account_id")
  userId             String @map("user_id")

  brandName      String? @map("brand_name")
  campaign       String?
  budgetAmount   Float?  @map("budget_amount")
  budgetCurrency String? @map("budget_currency")
  deliverables   String? // human-readable text (e.g. "1 Reel + 3 Stories")
  deadline       String? // free text; AI rarely returns a reliable ISO date
  contactEmail   String? @map("contact_email")
  website        String?
  usageRights    String? @map("usage_rights")
  confidence     Float   @default(0)

  status    String   @default("new") // "new", "contacted", "negotiating", "confirmed", "declined", "expired"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversation     Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([instagramAccountId])
  @@map("brand_deals")
}

// ============================================
// Reply Generation — append-only history of AI-drafted replies.
// Generating a draft NEVER sends a message; only an explicit creator
// action against /api/conversations/:id/reply sends via the Instagram API.
// ============================================
model ReplyGeneration {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  contextRef     String?  @map("context_ref") // short description of the context used (summary id / message count / trigger)
  instructions   String? // optional creator-provided instruction for this generation
  generatedText  String   @map("generated_text")
  model          String?
  wasSent        Boolean  @default(false) @map("was_sent") // set true if this exact draft was later sent (best-effort audit trail)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
  @@map("reply_generations")
}

// ============================================
// Creator Preferences — personalizes AI prioritization & reply tone.
// ============================================
model CreatorPreference {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  brandDealsPriority     String @default("high") @map("brand_deals_priority") // critical/high/normal/low/off
  collaborationsPriority String @default("high") @map("collaborations_priority")
  customersPriority      String @default("high") @map("customers_priority")
  fanPriority            String @default("normal") @map("fan_priority")
  questionsPriority      String @default("normal") @map("questions_priority")
  spamPriority           String @default("low") @map("spam_priority")

  tone                String   @default("friendly") // friendly/professional/casual/custom
  customInstructions  String?  @map("custom_instructions")
  autoGenerateSummary Boolean  @default(true) @map("auto_generate_summary")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_preferences")
}

// ============================================
// Notification — creator-facing alerts for important events.
// ============================================
model Notification {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  type           String // new_brand_deal, high_priority_conversation, important_customer, ai_analysis_completed, instagram_connection_problem
  title          String
  body           String?
  conversationId String?  @map("conversation_id")
  brandDealId    String?  @map("brand_deal_id")
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ============================================
// Security Audit Log for Admin Actions
// ============================================
model AdminLog {
  id          String   @id @default(uuid())
  adminUserId String   @map("admin_user_id")
  action      String // e.g. "USER_SUSPEND", "TOKEN_REFRESH", "ACCOUNT_DISCONNECT"
  targetType  String   @map("target_type") // "USER", "INSTAGRAM_ACCOUNT", "SYSTEM"
  targetId    String?  @map("target_id")
  details     String? // JSON string or summary
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_logs")
}

// ============================================
// Super-admin identity — deliberately NOT a User.
//
// The old panel keyed admin on User.role / ADMIN_EMAILS, so a normal customer
// session (including a Google sign-in) could become an admin session, and the
// env-credential login wrote a fake "admin@codeback.internal" customer row.
// An admin now exists only here, is created only by scripts/create-admin.js
// (run by the owner, never over HTTP), and has no path to the customer app.
//
// passwordChangedAt doubles as the session invalidator: every admin session
// records the value it was minted under, and requireAdmin rejects a session
// whose copy no longer matches. A password change therefore logs out every
// other admin session without enumerating the session store.
// ============================================
model AdminUser {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until")
  lastLoginAt       DateTime? @map("last_login_at")
  lastLoginIp       String?   @map("last_login_ip")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  auditLogs AdminAuditLog[]

  @@map("admin_users")
}

// ============================================
// Append-only record of every admin login attempt and every admin mutation.
//
// adminId is NULL for a failed login against an address that is not an admin
// (there is nobody to attribute it to). SetNull, not Cascade: removing an
// admin must never erase what that admin did.
//
// Separate from AdminLog, which predates this and is also written by
// routes/auth.js for CUSTOMER security events (blocked Instagram links). That
// table keeps its history and its existing writers.
// ============================================
model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String?  @map("admin_id")
  action     String // e.g. ADMIN_LOGIN_SUCCESS, USER_SUSPEND
  targetType String?  @map("target_type") // USER, INSTAGRAM_ACCOUNT, ORDER, ADMIN_USER, SYSTEM
  targetId   String?  @map("target_id")
  reason     String? // the admin's written reason, where one is required
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

// ============================================
// Admin session store — connect-pg-simple's default shape, same as
// user_sessions, but a SEPARATE table. Customer-session cleanup
// (lib/session.js destroyUserSessions) deletes by sess->>'userId' and can
// therefore never reach an admin row, and vice versa. Created by a normal
// migration (unlike user_sessions, nothing created it at runtime first).
// ============================================
model AdminSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_admin_session_expire")
  @@map("admin_sessions")
}

// ============================================
// Runtime settings the admin panel can change without a deploy.
//
// One row per key; a MISSING row means "use the code default" (lib/settings.js
// holds every key's default and validation). Nothing is seeded, so a fresh
// database behaves exactly like today's code. Read through a short in-memory
// cache (single instance); Gate 7 adds the admin editor and the kill switches.
// ============================================
model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") // AdminUser id of the last editor
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ============================================
// Webhook Event & Health Log
// ============================================
model WebhookLog {
  id                 String   @id @default(uuid())
  instagramAccountId String?  @map("instagram_account_id")
  igUserId           String?  @map("ig_user_id")
  eventType          String   @map("event_type") // "message", "reaction", "read", "error"
  status             String // "SUCCESS", "FAILED", "SKIPPED"
  // Raw webhook body, minus tokens/secrets. This contains the CUSTOMER's
  // message text, so it is personal data belonging to a third party, not
  // just operational telemetry. Two rules follow from that:
  //   1. it is nulled 30 days after receipt (jobs/retentionJob.js), keeping
  //      the metadata row for debugging but dropping the message bodies;
  //   2. it dies with the account it belongs to — see onDelete below.
  payload            String? // JSON string (sanitized)
  errorMessage       String?  @map("error_message")
  createdAt          DateTime @default(now()) @map("created_at")

  // Cascade, not SetNull. Under SetNull, deleting a user or purging an
  // account left orphaned rows whose payload still held their customers'
  // DM text — directly contradicting what DELETE /auth/account promises and
  // what the published privacy policy now states.
  instagramAccount InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId])
  @@index([status, createdAt])
  @@map("webhook_logs")
}

// ============================================
// AUTH & IDENTITY (added by the auth hardening pass)
//
// NOTE ON ENUMS: the models above deliberately use plain Strings (see the
// header comment) because promoting them would have forced a data rewrite
// during the SQLite -> PostgreSQL move. That reason does not apply to NEW
// tables with no existing rows, so these use real Postgres enums — the values
// below are security-relevant control flow, and a typo in a String would fail
// open rather than fail to compile.
// ============================================

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

enum AuthProvider {
  GOOGLE
}

// Which flow a signed state token / nonce belongs to.
//
// Both OAuth flows sign with the SAME OAUTH_STATE_SECRET, so without a
// discriminator a state token minted for one flow is structurally valid when
// presented at the other flow's callback. `purpose` is carried INSIDE the
// signed payload (so it cannot be tampered with) and mirrored onto the nonce
// row; each callback verifies it matches before consuming the nonce.
enum OAuthPurpose {
  GOOGLE_LOGIN
  INSTAGRAM_CONNECT
}

enum DeletionRequestStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// Single-use, short-lived tokens for password reset and email verification.
//
// ONLY the SHA-256 of the token is stored. The raw value exists exactly once,
// in the email that was sent. A database leak therefore yields no usable
// reset tokens.
// ============================================
model AuthToken {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") // SHA-256 of the raw token, never the token
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at") // stamped on first use; a second use is rejected
  requestIp String?       @map("request_ip")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// ============================================
// A federated identity (Google today) linked to a Codeback user.
//
// Linking rule lives in the application layer, but the constraint that makes
// it safe lives here: (provider, providerAccountId) is unique, so one Google
// account can never be attached to two Codeback users.
// ============================================
model AuthIdentity {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") // Google's stable `sub`, NOT the email
  email             String
  emailVerified     Boolean      @default(false) @map("email_verified")
  createdAt         DateTime     @default(now()) @map("created_at")
  lastUsedAt        DateTime?    @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_identities")
}

// ============================================
// The trial-abuse ledger. Pseudonymised, and deliberately NOT related to User.
//
// This row must SURVIVE account deletion — that is the entire point. If it
// cascaded, deleting the account would reset the trial and the ledger would
// be worthless. It stores no raw Instagram id: igUserIdHash is
// HMAC-SHA256(igUserId, IG_IDENTITY_PEPPER), so the table cannot be used to
// enumerate which Instagram accounts have ever used Codeback.
//
// Retention: 18-24 months via purgeAfter, documented in PRIVACY_NOTES.md as a
// fraud-prevention basis.
//
// IG_IDENTITY_PEPPER CAN NEVER BE ROTATED. Rotating it makes every hash here
// unmatchable and grants every past trial user a fresh trial.
// ============================================
model InstagramIdentity {
  id              String    @id @default(uuid())
  igUserIdHash    String    @unique @map("ig_user_id_hash") // HMAC-SHA256(igUserId, IG_IDENTITY_PEPPER)
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at")
  trialConsumedAt DateTime? @map("trial_consumed_at") // set once, ever; the anti-abuse stamp
  linkCount       Int       @default(0) @map("link_count") // how many times this IG account has been linked
  blockedAt       DateTime? @map("blocked_at") // manual block; refuses connection outright
  purgeAfter      DateTime? @map("purge_after")

  @@index([purgeAfter])
  @@map("instagram_identities")
}

// ============================================
// Replay protection for the self-contained signed OAuth state token.
//
// The state token itself is stateless and HMAC-signed, which is what makes it
// survive a mobile browser switch. This table is what stops it being REPLAYED:
// the nonce is stamped used on first presentation.
//
// userId is NULLABLE and has no FK: a Google sign-in can legitimately start
// with no session at all (that is the whole point of "sign in with Google"),
// so there is no user to attribute the nonce to yet. Instagram connect always
// has a session and will always populate it.
// ============================================
model OAuthNonce {
  id String @id @default(uuid())
  // Which flow minted this nonce. Verified against the `purpose` inside the
  // signed state payload before the nonce is consumed, so a token minted for
  // Google login cannot be replayed at the Instagram callback or vice versa.
  //
  // NOT NULL with no default: the mint site must state the purpose explicitly.
  // The userId rule is enforced in application code, not by a DB constraint —
  // INSTAGRAM_CONNECT requires a non-null userId, GOOGLE_LOGIN permits null.
  purpose   OAuthPurpose
  nonce     String    @unique
  userId    String?   @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")

  @@index([expiresAt])
  @@map("oauth_nonces")
}

// ============================================
// Session store — created and managed at RUNTIME by connect-pg-simple
// (lib/session.js), never by application code and never by a Prisma
// migration's own logic. Modeled here only so Prisma stops treating it as
// unexplained drift on every `migrate dev`; column shape confirmed against
// the live table (`\d user_sessions`) and matches connect-pg-simple's own
// default schema exactly.
//
// The migration that introduces this model is adopted via
// `prisma migrate resolve --applied`, NOT a normal deploy, on any database
// where connect-pg-simple has already created the table at runtime (local
// dev, and almost certainly production — see FINDINGS.md F11 / the auth-
// hardening baseline). A normal `migrate deploy` against such a database
// would fail with "relation already exists". A database where the table
// does not exist yet (a fresh test DB) applies it normally.
// ============================================
model UserSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("user_sessions")
}

// ============================================
// Meta data-deletion callback bookkeeping.
//
// Meta requires us to return a confirmation code and host a status page for
// it. Previously the code was generated per request and stored nowhere, so
// the status endpoint returned a static "completed" for any code at all.
// Keyed by the same pseudonymised hash as InstagramIdentity.
// ============================================
model DeletionRequest {
  id           String                @id @default(uuid())
  code         String                @unique
  igUserIdHash String                @map("ig_user_id_hash")
  status       DeletionRequestStatus @default(RECEIVED)
  requestedAt  DateTime              @default(now()) @map("requested_at")
  completedAt  DateTime?             @map("completed_at")

  @@index([igUserIdHash])
  @@map("deletion_requests")
}

// ============================================
// DELIVERY-level webhook idempotency for Meta.
//
// Distinct from the MESSAGE-level dedupe on Message.igMessageId. Today a Meta
// retry still re-runs processEntry, rewrites lastWebhookAt and writes a
// duplicate WebhookLog row before the message-level check catches it; and an
// event carrying no `mid` gets no dedupe at all. This table stops the whole
// delivery at the door.
//
// KEY IS SHA-256 OF THE RAW REQUEST BODY, not entry.id + entry.time. Two
// genuinely different deliveries for the same account within the same second
// would collide on that pair and the second real message would be silently
// dropped. A body hash cannot collide across different deliveries, and if Meta
// ever re-serializes a retry the hash simply differs and we fall through to
// message-level dedupe — i.e. today's behaviour. The failure direction is safe.
//
// req.rawBody is already an exact Buffer (see index.js express.json verify),
// so the hash is over the bytes Meta signed.
//
// Checked AFTER signature verification, BEFORE processEntry, BEFORE the 200.
//
// GROWS UNBOUNDED — unlike the Cashfree table this replaces, every inbound DM
// writes a row. The 7-day purge job is mandatory, not optional; receivedAt is
// indexed for it. See FINDINGS.md.
//
// Replaces the orphaned `processed_webhook_events` table (created by a phantom
// migration, dropped in the cleanup path). Deliberately a NEW name: recreating
// the old one would fail on any database where the orphan still exists.
// ============================================
model WebhookDelivery {
  id           String   @id @default(uuid())
  provider     String   @default("meta")
  deliveryHash String   @map("delivery_hash") // SHA-256 hex of the raw request body
  receivedAt   DateTime @default(now()) @map("received_at")

  @@unique([provider, deliveryHash])
  @@index([receivedAt])
  @@map("webhook_deliveries")
}

// ============================================
// BILLING — plan catalogue, per-region pricing, one-time orders, and the
// credit/quota ledger for the feat/billing work. Inert on its own: nothing
// reads or writes these tables until the entitlement service (Gate 2) and
// BILLING_ENABLED exist. Reversible migration — see migration.sql.
//
// NAMING NOTE, read before renaming anything below: the first (reverted)
// Cashfree attempt's phantom migrations left an orphaned "plans" table (and
// an old-shape "subscriptions") on any database that applied them and never
// ran the cleanup in FINDINGS.md. `Plan` is therefore @@map'd to
// "billing_plans", NOT "plans" — creating a table literally named "plans"
// would fail outright on exactly the drifted databases that cleanup exists
// to fix. Same reasoning WebhookDelivery used to avoid the name
// "processed_webhook_events". "orders", "entitlements", "credit_ledger",
// "plan_prices" and "addon_*"/"extra_ig_account_prices" have no such
// history and are safe as named.
// ============================================

enum EntitlementStatus {
  NONE // default — no entitlement. Carried over from Subscription's own safety property: creating a row cannot accidentally grant one.
  TRIALING
  ACTIVE
  GRACE
  EXPIRED
}

enum CreditLedgerType {
  GRANT
  SPEND
  EXPIRE
  ROLLOVER
  CLASSIFY // a recorded classification event, not a credit movement — delta is always 0. See CreditLedger's messageId note.
}

// "Has a successful payment or not." A failed or abandoned ATTEMPT is not an
// order state — it is a PaymentAttempt row — because Cashfree lets a customer
// retry on the same order. See migration 20260915190000_payment_attempts_order_state.
enum OrderStatus {
  CREATED // no successful payment yet; still payable until it expires
  PAID
  EXPIRED // the ONLY terminal state, and only from expiry: Cashfree reported the order expired/terminated/unknown, or the reconciliation job's 7-day safety net fired (which alerts) — see billingReconciliationJob.js
}

// ============================================
// How a payment's country was established, for the region lock. Ordered
// from strongest to weakest evidence — never derived from currency alone,
// which is circular (currency is the pricing hint WE showed the customer,
// not evidence of where they actually are).
// ============================================
enum RegionSource {
  RAIL_INFERRED // UPI/netbanking/wallet — India-only by construction, no country field needed
  CARD_COUNTRY // card payment with a non-null payment_method.card.card_country
  UNVERIFIED // card payment with a null card_country (Cashfree's own sample payloads show this is common) — plan is granted, region stays unlocked
}

// ============================================
// One row per tenant — the live quota/expiry state the entitlement service
// (Gate 2, src/services/entitlementService.js) reads and writes on every
// classification/auto-reply attempt. Cascade-deletes with the user, same as
// the trial-only Subscription model it replaces — this is OPERATIONAL
// state, not a financial record (contrast Order/CreditLedger below), and
// there is no ongoing entitlement to enforce for a deleted account.
//
// EXTENDS SUBSCRIPTION — Subscription (status/trialStartedAt/trialEndsAt)
// has been folded in here rather than kept as a second per-tenant row:
//   Subscription.status         -> status (NONE/TRIALING as-is; TRIAL_EXPIRED -> EXPIRED)
//   Subscription.trialStartedAt -> cycleStartedAt (a trial IS a cycle — a free
//                                  3-day one; Plan.cycleLengthDays=3 for TRIAL)
//   Subscription.trialEndsAt    -> validUntil
// See migration 20260914_merge_subscription_into_entitlement for the
// data backfill. status still defaults to NONE — that is the safety
// property Subscription had: creating a row cannot accidentally grant
// anything. planCode/billingRegion/currency are nullable for exactly that
// NONE state and for TRIALING, which locks neither region nor currency
// (only a real payment does, per the region-lock requirement).
//
// EFFECTIVE STATUS IS LAZY, same philosophy hasActiveEntitlement() already
// used for trial expiry: validUntil/graceUntil are the source of truth, and
// the entitlement service derives TRIALING/ACTIVE -> GRACE -> EXPIRED from
// them at read time rather than trusting the stored `status` column, which
// only a periodic sweep (Gate 4) eventually catches up to. graceUntil is
// set at grant time (validUntil + 3 days) for paid plans and left NULL for
// TRIAL — a trial has no grace stage, so the same lazy computation that
// derives GRACE for a paid plan falls straight through to EXPIRED for one.
//
// replyCreditsBanked = unspent credits rolled over from PRIOR cycles,
// capped at the plan's bank cap when the cycle rolls.
// replyCreditsCurrent = unspent credits granted THIS cycle (plan grant +
// any consumable add-on top-ups bought during it).
// FIFO spend drains banked (older) before current (newer). CreditLedger
// below is the append-only trail of every change to either number.
// ============================================
model Entitlement {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  planCode      String?           @map("plan_code") // Plan.code — TRIAL, STARTER, PRO, ENTERPRISE; null until a trial/plan is granted
  // billingRegion/currency are set ONLY from RAIL_INFERRED or CARD_COUNTRY
  // evidence (see RegionSource below) — NEVER inferred from currency alone,
  // which is circular: currency is what we showed the customer as a
  // pricing hint, so treating it as region evidence is exactly the VPN
  // arbitrage the lock exists to prevent. An UNVERIFIED payment still
  // grants the plan normally but leaves both null/unset, so a later
  // payment carrying real evidence can still set the lock.
  billingRegion String?           @map("billing_region") // locked at first RAIL_INFERRED/CARD_COUNTRY payment — IN | INTL; null pre-payment or UNVERIFIED
  currency      String? // locked together with billingRegion — INR | USD; null pre-payment or UNVERIFIED
  regionSource  RegionSource?     @map("region_source") // how billingRegion (if set) was established
  status        EntitlementStatus @default(NONE) // NONE default is deliberate — see the model note above

  validUntil DateTime? @map("valid_until")
  graceUntil DateTime? @map("grace_until") // validUntil + 3 days for paid plans; NULL for TRIAL (no grace stage)

  replyCreditsCurrent Int @default(0) @map("reply_credits_current")
  replyCreditsBanked  Int @default(0) @map("reply_credits_banked")

  classificationCountCycle Int      @default(0) @map("classification_count_cycle") // burst guard, never rolls over
  classificationCountHour  Int      @default(0) @map("classification_count_hour")
  hourWindowStartedAt      DateTime @default(now()) @map("hour_window_started_at")
  cycleStartedAt           DateTime @default(now()) @map("cycle_started_at")

  extraIgAccounts Int @default(0) @map("extra_ig_accounts") // recurring add-on count; folded into next renewal's price

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, validUntil])
  @@index([status, graceUntil])
  @@map("entitlements")
}

// ============================================
// Append-only. NEVER update or delete a row here — enforced by convention in
// application code (Gate 2), not by the schema — this is the record shown to
// a customer who disputes their own usage. A correction is a new row (e.g. a
// compensating GRANT or EXPIRE entry), never an edit to an existing one.
//
// tenantId is a plain field, not a User relation, and deliberately does NOT
// cascade on account deletion — see PRIVACY_NOTES.md "Retention 2": GST
// rules require retaining invoice-linked transaction records independent of
// the account that generated them, once billing is live. Same reasoning as
// InstagramIdentity's deliberate non-relation to User.
//
// messageId + the (tenantId, messageId, type) unique constraint below are
// what make a CLASSIFY entry idempotent — a retried Gemini call, or a
// Gemini->xAI->OpenAI failover, all resolve to the SAME messageId, so
// recordClassification()'s insert collides (P2002) on the second and third
// attempt and is treated as a no-op rather than a second count. GRANT/
// SPEND/EXPIRE/ROLLOVER rows leave messageId NULL, and Postgres unique
// constraints never consider two NULLs equal, so those rows never collide
// with each other or with a CLASSIFY row.
// ============================================
// ============================================
// One row per renewal reminder actually sent.
//
// EXISTS PURELY AS AN IDEMPOTENCY GUARD. The renewal sequence runs on a
// timer several times a day, and every run re-evaluates the same windows —
// without this, a tenant three days from expiry would be emailed on every
// single pass. The unique constraint below is what makes "send once per
// cycle per reminder type" structural rather than a matter of getting the
// scheduling arithmetic exactly right: the job inserts BEFORE sending and
// treats a P2002 as "already sent, skip", the same pattern CreditLedger's
// CLASSIFY rows use for classification.
//
// cycleStartedAt identifies WHICH cycle the reminder belongs to, rather
// than a cycle number we would have to maintain. It is restamped by every
// grantPlan() and every rollCycle(), so a renewed tenant automatically
// becomes eligible for a fresh set of reminders with no cleanup step.
//
// tenantId is a plain field with no User relation, matching CreditLedger
// and Order: deliberately NOT cascading, so the record of what was sent
// survives the account it was sent to.
// ============================================
model RenewalReminder {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  cycleStartedAt DateTime @map("cycle_started_at")
  reminderType   String   @map("reminder_type") // DAY_27 | DAY_29 | EXPIRY | GRACE_FINAL
  sentAt         DateTime @default(now()) @map("sent_at")

  @@unique([tenantId, cycleStartedAt, reminderType])
  @@index([tenantId, sentAt])
  @@map("renewal_reminders")
}

model CreditLedger {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  messageId    String?          @map("message_id") // set only for type=CLASSIFY; the idempotency key
  delta        Int // positive = credited, negative = spent
  type         CreditLedgerType
  source       String // e.g. "plan_grant:starter", "addon:reply_credits_500", "auto_reply_spend", "cycle_rollover", "classification"
  balanceAfter Int              @map("balance_after")
  note         String? // detail for the row; a refund revocation records granted / removed / shortfall here
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([tenantId, messageId, type])
  @@index([tenantId, createdAt])
  @@map("credit_ledger")
}

// ============================================
// One row per Cashfree order — plan purchases/renewals AND add-on
// purchases. cashfreeOrderId's unique constraint is the idempotency guard
// for the webhook (Gate 3): a replayed delivery hitting this constraint is
// what stops a double-grant/double-extend, not an in-memory set — this is a
// single-instance deployment with no row-level locking.
//
// tenantId does not cascade on account deletion — see CreditLedger's note
// and PRIVACY_NOTES.md "Retention 2".
//
// Exactly one of planCode / addonCode is set, never both, never neither —
// enforced in application code (Gate 3), not by the schema.
// ============================================
model Order {
  id              String       @id @default(uuid())
  cashfreeOrderId String       @unique @map("cashfree_order_id")
  tenantId        String       @map("tenant_id")
  planCode        String?      @map("plan_code")
  addonCode       String?      @map("addon_code")
  amount          Int // smallest currency unit — paise (INR) or cents (USD)
  currency        String
  status          OrderStatus  @default(CREATED)
  paymentCountry  String?      @map("payment_country") // from the Cashfree webhook; raw value behind regionSource's classification
  regionSource    RegionSource? @map("region_source") // how paymentCountry (if any) was established — see the enum's own comment
  rawPayload      String?      @map("raw_payload") // last webhook payload received for this order, for reconciliation
  // What the grant changed, written in the fulfilment transaction (Gate 11c):
  // { priorPlanCode, priorStatus, priorValidUntil, priorGraceUntil,
  //   grantedValidUntil, grantedGraceUntil, grantedDays, grantedCredits }.
  // A refund's revocation reads it — "validUntil before the order" cannot be
  // reconstructed afterwards. NULL for orders paid before it existed.
  grantSnapshot   Json?        @map("grant_snapshot")
  // extra_ig_account orders only: when an Instagram account was first connected
  // using this slot. Set once, never cleared; it closes the slot's refund window.
  // See entitlementService.recordInstagramSlotUsage.
  slotUsedAt      DateTime?    @map("slot_used_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  paidAt          DateTime?    @map("paid_at")

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("orders")
}

// ============================================
// One row per payment attempt outcome Cashfree reported for an order — the
// attempt-level record that keeps "one try failed" out of the order's own
// state. Written by the webhook (SUCCESS / FAILED / USER_DROPPED) and by
// fulfilment, including a reconciliation heal.
//
// Replays are harmless: (cashfreeOrderId, cfPaymentId, status) is unique and
// writes use skipDuplicates. A payload with no cf_payment_id stores NULL,
// which Postgres never treats as equal, so such rows are kept rather than lost.
//
// No relation to Order or User, matching Order/CreditLedger: a financial
// trail that outlives the account.
// ============================================
model PaymentAttempt {
  id              String   @id @default(uuid())
  cashfreeOrderId String   @map("cashfree_order_id")
  cfPaymentId     String?  @map("cf_payment_id")
  status          String // Cashfree payment_status: SUCCESS | FAILED | USER_DROPPED | ...
  eventType       String   @map("event_type") // the webhook type, or RECONCILIATION for a heal
  paymentGroup    String?  @map("payment_group")
  failureReason   String?  @map("failure_reason")
  rawPayload      String?  @map("raw_payload")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([cashfreeOrderId, cfPaymentId, status])
  @@index([cashfreeOrderId, createdAt])
  @@map("payment_attempts")
}

// ============================================
// Refunds (Gates 11b/11c). Admin-initiated only — there is no self-serve
// refund. status ONLY ever comes from Cashfree: the create response, the
// REFUND_STATUS_WEBHOOK, or an admin re-sync. REQUESTED means the row exists
// but Cashfree has not answered, so it is never mistaken for a success.
// ============================================
enum RefundStatus {
  REQUESTED // written before the Cashfree call; resolved by its answer or a re-sync
  PENDING
  ONHOLD
  SUCCESS // terminal
  CANCELLED // terminal
  FAILED // terminal
}

// A partial refund is a row whose amount is less than the order's. Revocation
// (services/refundService.js) runs once, when SUCCESS refunds on an order reach
// its full amount; a partial SUCCESS revokes nothing and alerts a human.
//
// No relation to Order or User, matching Order/CreditLedger: a financial record
// that outlives the account.
model Refund {
  id                String       @id @default(uuid())
  refundId          String       @unique @map("refund_id") // ours, sent to Cashfree as refund_id and the idempotency key
  cashfreeOrderId   String       @map("cashfree_order_id")
  tenantId          String       @map("tenant_id")
  amount            Int // smallest currency unit
  currency          String
  reason            String
  status            RefundStatus @default(REQUESTED)
  cfRefundId        String?      @map("cf_refund_id")
  arn               String? // bank reference, once Cashfree has one
  statusDescription String?      @map("status_description")
  initiatedBy       String       @map("initiated_by") // admin user id, or "cashfree:external" for a refund issued outside Siffty
  overridePolicy    Boolean      @default(false) @map("override_policy") // true only when issued outside the refund policy
  overrideReason    String?      @map("override_reason") // mandatory whenever overridePolicy is true
  policyCheck       Json?        @map("policy_check") // eligibility and the usage numbers it was decided on, at initiation
  revokedAt         DateTime?    @map("revoked_at") // set once, when this refund completed the order's full refund
  revocation        Json? // what revocation changed: validity, credits removed, shortfall, status
  lastError         String?      @map("last_error")
  rawPayload        String?      @map("raw_payload") // last Cashfree payload for this refund
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  processedAt       DateTime?    @map("processed_at")

  @@index([cashfreeOrderId])
  @@index([tenantId, createdAt])
  @@index([status])
  @@map("refunds")
}

// ============================================
// Plan catalogue — prices live in PlanPrice, never in application code or
// the frontend. @@map("billing_plans"), NOT "plans" — see the naming note
// at the top of this section.
// ============================================
model Plan {
  id   String @id @default(uuid())
  code String @unique // TRIAL, STARTER, PRO, ENTERPRISE

  name                          String
  igAccountLimit                Int?    @map("ig_account_limit") // null = custom (Enterprise)
  autoReplyCreditsPerCycle      Int?    @map("auto_reply_credits_per_cycle") // monthly grant; the trial's own TRIAL_AUTO_REPLY_CREDITS constant lives in code, not here
  autoReplyBankCap              Int?    @map("auto_reply_bank_cap") // max banked (rolled-over) credits; excess discarded at renewal
  classificationCapCycle        Int?    @map("classification_cap_cycle") // internal burst guard only — never advertised on marketing pages
  classificationThrottlePerHour Int?    @map("classification_throttle_per_hour")
  cycleLengthDays               Int     @default(30) @map("cycle_length_days") // 30-day purchases only — no multi-month packs by design
  isActive                      Boolean @default(true) @map("is_active")
  // Quoted, not checked out. ENTERPRISE carries real "from" prices in
  // PlanPrice so the marketing card can render an amount from the catalogue
  // rather than hardcoding one in a component — but it must show a contact
  // CTA instead of a buy button. Without this flag the only way to tell the
  // two apart would be "does it have a price row", which stops being true
  // the moment a from-price exists.
  isQuoteOnly                   Boolean @default(false) @map("is_quote_only")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prices PlanPrice[]

  @@map("billing_plans")
}

// ============================================
// Per-region, per-currency price for one plan's 30-day cycle.
// ============================================
model PlanPrice {
  id            String @id @default(uuid())
  planId        String @map("plan_id")
  billingRegion String @map("billing_region") // IN | INTL
  currency      String // INR | USD
  amount        Int // smallest currency unit — paise (INR) or cents (USD)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingRegion])
  @@map("plan_prices")
}

// ============================================
// Consumable add-on: a one-time top-up of auto-reply credits. Once
// purchased it is subject to the same bank-cap/expiry rules as the plan's
// own grant — enforced by CreditLedger + Entitlement, not here.
//
// Kept as its own table rather than folded into a generic "Addon" table
// with ExtraIgAccountPrice below — the brief is explicit that consumable
// and recurring add-ons behave too differently to share one shape (this one
// has a credit quantity and no ongoing effect; the other has no quantity
// and persists for as long as the plan is active).
// ============================================
model AddonPack {
  id           String  @id @default(uuid())
  code         String  @unique // e.g. "reply_credits_500"
  creditAmount Int     @map("credit_amount")
  isActive     Boolean @default(true) @map("is_active")

  prices AddonPackPrice[]

  @@map("addon_packs")
}

// Priced per PURCHASING plan tier (Starter/Pro), not by region alone — the
// brief prices this cheaper on Pro on purpose, as the lever that pulls a
// Starter tenant toward upgrading.
model AddonPackPrice {
  id            String @id @default(uuid())
  addonPackId   String @map("addon_pack_id")
  planCode      String @map("plan_code") // which plan tier this price applies to — STARTER | PRO
  billingRegion String @map("billing_region")
  currency      String
  amount        Int

  addonPack AddonPack @relation(fields: [addonPackId], references: [id], onDelete: Cascade)

  @@unique([addonPackId, planCode, billingRegion])
  @@map("addon_pack_prices")
}

// ============================================
// Recurring add-on: +1 IG account slot. No "pack" concept applies — a
// tenant simply has N extra slots or doesn't — so pricing is keyed directly
// on purchasing plan tier and region, same reasoning as AddonPackPrice.
// The purchased count itself lives on Entitlement.extraIgAccounts, not here.
// ============================================
model ExtraIgAccountPrice {
  id            String @id @default(uuid())
  planCode      String @map("plan_code") // STARTER | PRO
  billingRegion String @map("billing_region")
  currency      String
  amount        Int

  @@unique([planCode, billingRegion])
  @@map("extra_ig_account_prices")
}
